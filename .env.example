# Bu faylning nusxasini `.env` deb saqlang va qiymatlarni to'ldiring.
# `.env` git'ga tushmaydi (.gitignore da).

# --- Majburiy ---

# @BotFather bergan bot tokeni
BOT_TOKEN=

# --- Rasmni kim o'qiydi: Gemini yoki Anthropic (bittasi yetarli) ---

# Gemini kaliti: aistudio.google.com/apikey
# DIQQAT: kalit `AIza` bilan boshlanadi. `AQ.` bilan boshlanadigan narsa
# OAuth tokeni — u bu yerda ishlamaydi.
#
# MAXFIYLIK: Google'ning BEPUL tarifida yuborilgan ma'lumot model
# o'qitishga ishlatiladi va odam ko'rib chiqishi mumkin. Pasport skanlari
# uchun PULLIK tarifni yoqing — unda "content not used to improve our
# products" deb belgilangan.
GEMINI_API_KEY=

# Anthropic kaliti: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Qaysi biri ishlatiladi: gemini | anthropic
# Bo'sh qoldirilsa — qaysi kalit mavjud bo'lsa, o'shanisi tanlanadi.
PROVIDER=

# --- Ixtiyoriy ---

# Botdan foydalanishga ruxsat berilgan Telegram chat id'lari, vergul bilan.
#
# BUNI TO'LDIRISH SHART EMAS: birinchi ishga tushirishda terminalda kod
# chiqadi, uni botga yuborsangiz ruxsat bazaga yozilib qoladi. Keyingi
# xodimlarni botdagi /kod buyrug'i bilan qo'shasiz.
#
# Bu yerga yozilgan id'lar esa hech qachon o'chmaydi — serverda "zaxira
# kalit" sifatida bittasini yozib qo'yish mumkin.
OPERATORS=

# Gemini modeli. Aniq nomini aistudio.google.com da ko'rasiz.
# MRZ — mayda shriftdagi aniqlik ishi, shuning uchun Flash tavsiya etiladi.
# Flash-Lite arzonroq, lekin belgilarni ko'proq xato o'qadi (tekshiruv
# raqamlari buni ushlaydi, lekin rasmni qayta olish kerak bo'ladi).
GEMINI_MODEL=gemini-2.5-flash

# Anthropic modeli. Arzonroq: claude-sonnet-5-5 yoki claude-haiku-4-5.
# Diqqat: MRZ ni xato o'qish = xato viza, shuning uchun eng arzoniga
# o'tishdan oldin bir necha pasportda sinab ko'ring.
MODEL=claude-opus-5-5

# Baza fayli (bitta fayl, server kerak emas)
DB_PATH=./data/umra.db

# Hujjat rasmlari saqlanadigan papka.
#
# DIQQAT: bu papkada mijozlarning pasport skanlari turadi.
# Umumiy kompyuterda qoldirmang, zaxirasini ochiq joyga yuklamang.
# RETENTION_DAYS o'tgach rasm ham yozuv bilan birga o'chadi.
PHOTOS_DIR=./data/photos

# Zip arxivining chegarasi (MB). Telegram bot 50 MB dan kattasini
# yubora olmaydi, shuning uchun undan pastda to'xtaymiz.
ZIP_MAX_MB=45

# Ma'lumot shuncha kundan keyin o'zi o'chadi.
# Viza rasmiylashtirilgach ma'lumot kerak emas — muddatni imkon qadar qisqa tuting.
RETENTION_DAYS=180

# Umra uchun pasport kamida shuncha oy amal qilishi kerak.
# Shundan kam qolganlar hisobotda va Excelda sariq/qizil bo'lib ajralib turadi.
MIN_PASSPORT_MONTHS=6

# Bir xodim kuniga shuncha rasmdan ko'p yubormaydi.
# Maqsadi — xato bilan yuzlab rasm yuborilib, API hisobini yeb qo'yishdan saqlash.
DAILY_LIMIT=300

# API'ga daqiqada shuncha so'rov yuboriladi.
#
# NEGA KERAK: Gemini bepul tarifida daqiqada 10–15 so'rov chegarasi bor.
# 30 rasm to'xtamasdan yuborilsa, 11-rasmda chegaraga uriladi va to'plam
# to'xtab qolardi. Bot so'rovlarni teng taqsimlaydi — 30 rasm 3 daqiqada
# o'qiladi, lekin to'xtamaydi.
#
# Bo'sh qoldirilsa: Gemini uchun 10, Anthropic uchun 40.
# Pullik tarifda oshirsangiz bo'ladi (masalan 60).
REQUESTS_PER_MINUTE=

# Bitta rasmning eng katta hajmi (MB).
#
# Fayl (File) sifatida yuborilgan telefon rasmi 5–9 MB bo'ladi va API'da
# tushunarsiz xato beradi. Undan kattasi darhol rad etiladi va xodimga
# "oddiy rasm sifatida yuboring" deyiladi. Oddiy rasmni Telegram o'zi
# siqib beradi (~1280px) — MRZ shunda ham o'qiladi.
IMAGE_MAX_MB=3.5

# Albom yuborilganda shuncha millisekund jim turilgandan keyin
# to'plangan rasmlar birga o'qiladi va BITTA hisobot beriladi.
# Internet sekin bo'lsa oshiring (masalan 4000).
BATCH_WAIT_MS=2500

# Rasmni hujjatning o'ziga qirqish (standart — yoqilgan).
#
# Model MRZ bilan birga hujjatning kadrdagi chegarasini ham aytadi, bot
# esa rasmni shu bo'yicha qirqadi: arxivda stol va qo'l emas, pasportning
# o'zi qoladi. Chegara ishonchsiz bo'lsa qirqilmaydi — yarmi kesilgan
# pasport butun kadrdan yomonroq.
#
# O'chirish: CROP=off
CROP=

# Qirqishda hujjat chetiga qo'shiladigan bo'sh joy (kadr kengligining %).
# Model chegarani bir-ikki foiz ichkaridan ko'rsatsa ham pasportning
# qirrasi kesilmasligi uchun.
CROP_MARGIN_PCT=2

# Soat mintaqasi. Sana va kunlik chegara shu bo'yicha hisoblanadi.
# Bo'sh qoldirsangiz: Asia/Tashkent
TZ_NAME=

# Zaxira paroli — FAQAT avtomatik zaxira uchun (Task Scheduler kabi).
# Odatda bo'sh qoldiriladi va parol qo'lda kiritiladi: parol .env da
# tursa, zaxira fayli bilan bir joyda qolib ketishi mumkin.
ZAXIRA_PAROL=
